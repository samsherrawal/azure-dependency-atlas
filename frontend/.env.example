# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env.local and fill in your actual values
# .env.local is in .gitignore and will NOT be committed to version control
#
# SECURITY: Never commit real credentials to the repository
# ============================================

# API Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_TOKEN=your-auth-token-here
VITE_AUTH_URL=https://auth.example.com

# Feature Flags
VITE_ENABLE_REAL_TIME_UPDATES=false
VITE_ENABLE_RAG_CHATBOT=true
VITE_ENABLE_BLAST_RADIUS=true

# Logging & Debugging
VITE_LOG_LEVEL=info
VITE_DEBUG_MODE=false

# Analytics (optional)
# VITE_ANALYTICS_KEY=your-analytics-key
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com

# Infrastructure Data Source (optional)
# VITE_DATA_SOURCE=mock|api|websocket
# VITE_WEBSOCKET_URL=wss://realtime.example.com

# ============================================
# NOTES:
# ============================================
# - This file is a TEMPLATE only
# - Copy it to .env.local for your local setup
# - Update values for your environment
# - .env.local is in .gitignore (not tracked)
# - For production: use your secrets management system
# - NEVER commit real credentials to version control
# ============================================
